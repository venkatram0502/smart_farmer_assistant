  // ============================================================
  // GREETING
  // ============================================================

  String _getGreeting() {
    final hour = DateTime.now().hour;

    if (hour >= 5 && hour < 12) {
      return isTelugu
          ? 'శుభ�<దయ�,, ${widget.username} �Y'<'
          : 'Good Morning, ${widget.username} �Y'<';
    }

    if (hour >= 12 && hour < 17) {
      return isTelugu
          ? 'శుభ మధ్యాహ్న�,, ${widget.username} �Y'<'
          : 'Good Afternoon, ${widget.username} �Y'<';
    }

    if (hour >= 17 && hour < 21) {
      return isTelugu
          ? 'శుభ సాయ�,త్ర�,, ${widget.username} �Y'<'
          : 'Good Evening, ${widget.username} �Y'<';
    }

    return isTelugu
        ? 'శుభ రాత్రి, ${widget.username} �YOT'
        : 'Good Night, ${widget.username} �YOT';
  }

